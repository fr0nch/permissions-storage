{% set name = "permissions-storage" %}
{% set version = "REPLACE_VERSION" %}

package:
  name: {{ name|lower }}
  version: {{ version }}

source:
  path: .

build:
  number: 0
  string: "{{ target_platform | replace('-', '_') }}"
  missing_dso_whitelist:
    - "*/ld-linux*.so.*"  # [linux]
    - "*/libc.so.*"       # [linux]
    - "*/libm.so.*"       # [linux]
    - "*/libdl.so.*"      # [linux]
    - "*/libpthread.so.*" # [linux]
    - "*/librt.so.*"      # [linux]

requirements:
  run:
    - __glibc >=2.28 # [linux64]

test:
  commands:
    - test -f $PREFIX/bin/libpermissions-storage.so                # [linux]
    - test -f $PREFIX/permissions-storage.pplugin                  # [linux]
    - if not exist %PREFIX%\\bin\\libpermissions-storage.dll exit 1   # [win]
    - if not exist %PREFIX%\\permissions-storage.pplugin exit 1       # [win]

about:
  home: https://github.com/{{ environ.get('GITHUB_REPOSITORY', 'fr0nch/permissions-storage') }}
  license: MIT
  license_family: MIT
  license_file: LICENSE
  summary: Storage extension for the Plugify permissions plugin
  description: Persistent storage of groups, user permissions and cookies for the permissions plugin (MySQL, PostgreSQL, SQLite).
  doc_url: https://github.com/{{ environ.get('GITHUB_REPOSITORY', 'fr0nch/permissions-storage') }}/blob/main/README.md
  dev_url: https://github.com/{{ environ.get('GITHUB_REPOSITORY', 'fr0nch/permissions-storage') }}

extra:
  recipe-maintainers:
    - {{ environ.get('GITHUB_ACTOR', 'fr0nch') }}
